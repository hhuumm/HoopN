{
  "name": "hoopn",
  "version": "1.0.0",
  "private": true,
  "description": "Find, create, and join local pickup basketball games.",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "bcrypt": "^6.0.0",
    "bootstrap": "^4.6.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.4",
    "morgan": "^1.12.0",
    "react": "^19.2.8",
    "react-bootstrap": "^1.6.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^5.3.4",
    "react-transition-group": "^4.4.5"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names api,web \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite",
    "dev:server": "node --watch server.js",
    "start": "node server.js",
    "build": "vite build",
    "test": "vitest run",
    "check": "npm run test && npm run build"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "jsdom": "^30.0.1",
    "supertest": "^7.2.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
